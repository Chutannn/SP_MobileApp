assets/logo*
assets/*.png
assets/*.jpg
assets/*.jpeg
assets/*.webp
!assets/.gitkeep
*logo*
*logo_sp*
*sari_purnama*
*sari-purnama*
*saripurnama*
*sari_purnama*.*
*sari-purnama*.*
*saripurnama*.*
*detail*sari*
*nota*
*po_sample*
*contoh_po*

